# ==============================================================
# MentaBot Workspace Configuration Template
# Copy this file to .env and insert your real credentials
# NEVER commit the active .env with live keys to version control
# ==============================================================

# LLM Provider Configuration (Google Gemini)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# History & Context Limits
MAX_HISTORY_TURNS=10

# Backend Server Configuration
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
FLASK_DEBUG=True

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:5000/api
