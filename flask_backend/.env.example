# ==============================================================
# MentaBot Backend Configuration Template
# Copy this file to .env and insert your real provider credentials
# NEVER commit the active .env with live keys to version control
# ==============================================================

# LLM Provider Configuration (Google Gemini)
# Obtain a beginner-friendly key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# History & Context Limits
MAX_HISTORY_TURNS=10

# Server Configuration
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
FLASK_DEBUG=True
